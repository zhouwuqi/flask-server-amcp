# AgentPlus 回调基地址 —— 所有回调(async message / write temp / write struct)都拼在这上面。
# 不设则默认走官方云端 https://server.agentplus.cloud
#
# 自建/私有部署:
# AGENTPLUS_BASE_URL=https://your.agentplus.host
#
# 本地联调(直接打到本地 gunicorn):
# AGENTPLUS_BASE_URL=http://127.0.0.1:1000

AGENTPLUS_BASE_URL=https://server.agentplus.cloud
