# 复制成 .env 再改。所有项都可以不填。

# AgentPlus 回调基地址:建卡片、改卡片、写 temp、写笔记本都发到这里。
# 不填 = 官方云端 https://server.agentplus.cloud
# 自建部署:  AGENTPLUS_BASE_URL=https://your.agentplus.host
# 本地联调:  AGENTPLUS_BASE_URL=http://127.0.0.1:1000
AGENTPLUS_BASE_URL=https://server.agentplus.cloud

# 共享密钥。AgentPlus 调你的服务时不带认证头,配了这个之后,
# 只有 params.amcp_secret 和它一致的调用才会被处理。
# 在 AgentPlus 的「设置 → A-MCP」里,把同样的值填进每个工具的 params.amcp_secret。
# 生成一个:python -c "import secrets; print(secrets.token_urlsafe(32))"
AMCP_SHARED_SECRET=

# 本服务对外的地址。manifest 用它把工具配置里的相对 url(如 /amcp/sync)补全。
# 不填 = 用请求进来时的地址(放在反代后面时,反代要转发 X-Forwarded-Proto / X-Forwarded-Host)。
# AMCP_PUBLIC_URL=https://amcp.example.com

# 监听地址(run.sh 和 python main.py 都认)
# HOST=0.0.0.0
# PORT=3400
# WORKERS=1
